# Blockchain
RPC_URL=https://eth-sepolia-testnet.api.pocket.network
CHAIN_ID=11155111
START_BLOCK=9884750
POLL_INTERVAL_MS=5000
# Reduce batch size to avoid rate limits
BLOCK_BATCH_SIZE=50
# Increase retries for rate limit handling
RPC_MAX_RETRIES=5
RPC_RETRY_DELAY_MS=3000
# Add delays between requests (milliseconds)
RPC_REQUEST_DELAY_MS=300
# Backoff time after rate limit (seconds)
RPC_RATE_LIMIT_BACKOFF_SECS=60

# Kafka
KAFKA_BROKERS=localhost:9092

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/theragraph_dev

# Contracts
THERA_SNAP_ADDRESS=0x8CfB9Ea2fbeFf78Ee4423267De512971FE1375EC
THERA_ART_ADDRESS=0xa57A08769C26914a6Fd4344fCD8de90fb80a79B8
THERA_MUSIC_ADDRESS=0x252eacC3AcD39790D6EDDbCE90e8EBA30F031d9c
THERA_VID_ADDRESS=0xf661ddE72f3dcC7b16b1Df8D7d8864619049fD75
THERA_FRIEND_ADDRESS=0xYOUR_THERAFRIEND_CONTRACT_ADDRESS
# v10 TheraFriendzV2 — the contract the app mints against today. Optional:
# defaults to the known Sepolia deployment if unset. See
# therawallet/contracts/TheraFriendzV2.sol.
THERA_FRIENDZ_V2_ADDRESS=0xYOUR_THERAFRIENDZ_V2_CONTRACT_ADDRESS
