# Production Environment Variables - Rust Indexer
# Copy this to Coolify environment variables

# ============================================
# DATABASE (Coolify Managed PostgreSQL)
# ============================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@postgres:5432/theragraph_rust_prod

# ============================================
# KAFKA (Internal Network)
# ============================================
KAFKA_BROKERS=kafka:29092

# ============================================
# BLOCKCHAIN (Sepolia Testnet)
# ============================================
RPC_URL=https://eth-sepolia-testnet.api.pocket.network
CHAIN_ID=11155111
START_BLOCK=9884750
POLL_INTERVAL_MS=2000

# ============================================
# SMART CONTRACTS
# ============================================
THERA_SNAP_ADDRESS=0x8CfB9Ea2fbeFf78Ee4423267De512971FE1375EC
THERA_ART_ADDRESS=0xa57A08769C26914a6Fd4344fCD8de90fb80a79B8
THERA_MUSIC_ADDRESS=0x252eacC3AcD39790D6EDDbCE90e8EBA30F031d9c
THERA_FLIX_ADDRESS=0xf661ddE72f3dcC7b16b1Df8D7d8864619049fD75

# ============================================
# LOGGING
# ============================================
RUST_LOG=info

# ============================================
# NEBULA GRAPH — production settings
# ============================================
NEBULA_HOST=graphd
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
# Pool transport is the default (persistent connections, ~10-100× faster than subprocess).
# Set NEBULA_POOL=false ONLY for local dev without a running Nebula instance.
# NEBULA_POOL=false
NEBULA_POOL_SIZE=16

# DLQ rate limiter: max DB inserts per 60-second window during outages.
# Default is 100; lower if Postgres is under pressure.
# NEBULA_DLQ_RATE_LIMIT_PER_MIN=100

# Schema version — must match NEBULA_SCHEMA_VERSION in schema_consts.rs.
# Set NEBULA_SKIP_VERSION_CHECK=true ONLY when operator has manually verified the mismatch.
# NEBULA_SKIP_VERSION_CHECK=true
